PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
LOG_DIR=./check/logs
APP_NAME=GPSHouse
JWT_SECRET=
JWT_REFRESH_SECRET=
MONGO_DB_NAME=gps_house
MONGO_CLIENT_URL=mongodb://localhost:27017
MYSQL_DB_HOST=localhost
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=
MYSQL_DB_NAME=gps_house
MYSQL_DB_PORT=3306
MYSQL_DB_POOL_MIN=2
MYSQL_DB_POOL_MAX=10
ALLOWED_ORIGINS=*
SECRET_API_KEY=
API_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000
ENABLE_SWAGGER_DOC=true

# Redis (required for GPS: IMEI cache + worker -> API socket pub/sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# ── Process role ──
# all | api | gps-worker | gps-report-worker   (ecosystem.config.js runs api + gps-worker + gps-report-worker)
APP_RUNTIME_ROLE=all
# Unique per co-hosted deployment: prefixes Redis keys, socket rooms, pub/sub channels and queue rows
APP_CLIENT_NAMESPACE=gps_house

# ── GPS listener (TCP) ──
VEHICLE_GPS_ENABLED=true
GPS_LISTENER_ENABLED=true
# name:port:protocol, comma separated (protocols: GT800N, GT801N)
GPS_LISTENERS=GT800N-1:5001:GT800N,GT801N-2:5002:GT801N
GPS_LISTENER_MAX_CONNECTIONS=1000
# Send WHERE# to devices that only send heartbeats for GPS_LOCATION_STALE_MS
GPS_LOCATION_POLL_ENABLED=true
GPS_LOCATION_POLL_CHECK_INTERVAL_MS=60000
GPS_LOCATION_STALE_MS=120000
GPS_LOCATION_POLL_COMMAND=WHERE#

# ── GPS queue (Mongo: gps_realtime_queue / gps_report_queue) ──
GPS_REALTIME_PROCESSOR_ENABLED=true
GPS_REALTIME_BATCH_SIZE=500
GPS_REALTIME_INTERVAL_MS=250
GPS_REPORT_PROCESSOR_ENABLED=true
GPS_REPORT_BATCH_SIZE=500
GPS_REPORT_INTERVAL_MS=1000
GPS_REPORT_WORKER_COUNT=1
GPS_QUEUE_LOCK_MS=180000
GPS_QUEUE_MAX_RETRIES=3

# ── GPS tuning ──
VEHICLE_GPS_IMEI_CACHE_REFRESH_MS=300000
GPS_SOCKET_EMIT_MIN_INTERVAL_MS=0
GPS_DISTANCE_MAX_SPEED_KMH=120
GPS_DISTANCE_MAX_SEGMENT_METERS=10000
GPS_INACTIVE_AFTER_MINUTES=180
GPS_RUNNING_SPEED_THRESHOLD_KMH=0
GPS_HISTORY_MAX_POINTS=10000

# ── Reverse geocoding (live address) ──
# Public Nominatim allows max 1 request/second and requires an identifying User-Agent.
# For many vehicles, self-host Nominatim and point GEOCODER_URL at it (then lower GEOCODER_MIN_INTERVAL_MS).
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=GPSHouse-Backend/1.0
GEOCODER_LANGUAGE=en
GEOCODER_MIN_INTERVAL_MS=1000
GEOCODER_MIN_MOVE_METERS=100
GEOCODER_TIMEOUT_MS=5000
GEOCODER_CACHE_TTL_SECONDS=2592000
