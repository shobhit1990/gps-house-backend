{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts", "src/mikro-orm.mysql.config.ts", "src/mikro-orm.mongo.config.ts"],
  "exclude": ["node_modules", "**/__tests__/**", "**/__test__/**", "**/*.test.ts"]
}
